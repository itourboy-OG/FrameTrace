<Window x:Class="FrameTrace.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FrameTrace" Title="Frame Trace" Icon="Assets/FrameTrace.ico" Style="{StaticResource {x:Type Window}}" Width="1280" Height="1120" MinWidth="1050" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <DataTemplate x:Key="RtssArtworkChoice">
   <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
  </DataTemplate>
  <Style x:Key="RtssArtworkItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
   <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
   <EventSetter Event="Loaded" Handler="PrepareArtworkPreview"/>
  </Style>
 </Window.Resources>
 <Grid>
  <local:GamingBackground x:Name="AnimatedBackground" IsHitTestVisible="False"/>
  <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/FrameTrace.png" Width="38" Height="38" Margin="0,0,12,0"/><TextBlock Text="FRAME TRACE" FontFamily="Segoe UI Semibold" FontSize="27" VerticalAlignment="Center"/><TextBlock x:Name="AppVersion" Foreground="#9EAABC" FontSize="12" VerticalAlignment="Bottom" Margin="10,0,0,5"/></StackPanel><TextBlock Text="Open your game. Your performance follows." Foreground="#9EAABC" Margin="0,7,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="HardwareStatus" Text="Connecting sensors…" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,20,0"/><Button x:Name="OverlayButton" Content="Overlay on" AutomationProperties.AutomationId="OverlayButton" Click="ToggleOverlay" Background="{DynamicResource Accent}" Foreground="#10221C"/></StackPanel>
  </Grid>
  <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="640" Background="#F0192426" BorderBrush="#38574F" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" AutomationProperties.AutomationId="UpdateBanner">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel MinWidth="240" MaxWidth="360" VerticalAlignment="Center"><TextBlock x:Name="UpdateBannerText" Text="A new Frame Trace update is available." FontSize="13"/><ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="4" Foreground="#83EFCD" Background="#293443" BorderThickness="0" Margin="0,6,0,0" AutomationProperties.AutomationId="UpdateDownloadProgress"/></StackPanel>
    <Button x:Name="InstallUpdateButton" Grid.Column="1" Content="Update now" Click="InstallUpdate" Padding="12,6" Margin="12,0,0,0" Background="#83EFCD" Foreground="#10221C" AutomationProperties.AutomationId="InstallUpdate"/>
    <Button x:Name="DismissUpdateButton" Grid.Column="2" Content="Not now" Click="DismissUpdateBanner" Padding="12,6" Margin="8,0,0,0" AutomationProperties.AutomationId="DismissUpdate"/>
   </Grid>
  </Border>
  <TabControl x:Name="Pages" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#F1F4F8" Padding="0,18,0,0" SelectionChanged="PageChanged">

   <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" CornerRadius="7" Padding="22,11" Margin="0,0,8,0" Background="#1B222D"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#305046"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>

   <TabItem Header="Dashboard" AutomationProperties.AutomationId="DashboardTab">

    <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto"><StackPanel>

     <Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GAME CAPTURE" Foreground="{DynamicResource Accent}" FontSize="12"/><TextBlock x:Name="GameName" Text="Waiting for your game" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock x:Name="CaptureState" Text="Capture starts automatically. No executable filename or Start button needed." Foreground="#AEBED1" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Capture target" Margin="0,0,0,5" Foreground="#AEBED1"/><ComboBox Style="{StaticResource CaptureTargetStyle}" x:Name="CaptureTargetSelector" AutomationProperties.AutomationId="CaptureTargetSelector" HorizontalAlignment="Stretch" MinWidth="240" MaxDropDownHeight="320" PreviewMouseDown="OpenCaptureTargetsBeforeMouse" PreviewKeyDown="OpenCaptureTargetsBeforeKey" SelectionChanged="ChangeCaptureTarget"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><WrapPanel Margin="0,8,0,0"><Button x:Name="AllowCaptureButton" Content="✓ Allow" Click="AllowCaptureTarget" IsEnabled="False" ToolTip="Allow this executable in automatic capture" AutomationProperties.AutomationId="AllowCapture"/><Button x:Name="IgnoreCaptureButton" Content="✕ Ignore" Click="IgnoreCaptureTarget" IsEnabled="False" ToolTip="Exclude this executable from automatic capture" AutomationProperties.AutomationId="IgnoreCapture" Margin="6,0,0,0"/><Button x:Name="RetryButton" Content="Restart capture" AutomationProperties.AutomationId="RetryCapture" Click="RetryCapture" Margin="6,0,0,0"/></WrapPanel><TextBlock x:Name="CaptureRuleStatus" Text="Select a running app to allow or ignore it in automatic capture." FontSize="12" Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Grid></Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="APP / PRESENT FPS" Style="{StaticResource Muted}"/><TextBlock x:Name="AppFps" Text="—" FontSize="42" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></StackPanel><Rectangle Grid.Column="1" Grid.RowSpan="2" Fill="#34404D"/><StackPanel Grid.Column="2" Margin="18,0,14,0"><TextBlock Text="OBSERVED DISPLAY FPS" Style="{StaticResource Muted}"/><TextBlock x:Name="DisplayFps" Text="—" FontSize="42" FontWeight="SemiBold"/></StackPanel><Rectangle Grid.Column="3" Grid.RowSpan="2" Fill="#34404D"/><StackPanel Grid.Column="4" Margin="18,0,14,0"><TextBlock Text="AVERAGE FPS" Style="{StaticResource Muted}"/><TextBlock x:Name="AverageFps" Text="—" FontSize="38" FontWeight="SemiBold" Foreground="#DDE4EF"/><TextBlock Text="Rolling 30-second average" Style="{StaticResource Muted}"/></StackPanel><Rectangle Grid.Column="5" Grid.RowSpan="2" Fill="#34404D"/><StackPanel Grid.Column="6" Margin="18,0,0,0"><TextBlock Text="1% LOW FPS" Style="{StaticResource Muted}"/><TextBlock x:Name="LowFps" Text="—" FontSize="38" FontWeight="SemiBold" Foreground="#DDE4EF"/><TextBlock Text="Needs 100 frame samples" Style="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Row="1" Grid.ColumnSpan="7" Margin="0,8,0,0"><TextBlock x:Name="GenerationText" ToolTip="Capture tags AFMF and XeSS-FG. For Cyberpunk, the game's saved frame-generation setting may also appear. This does not verify a mod or driver override." Text="Frame generation · unavailable" TextWrapping="Wrap" Style="{StaticResource Muted}"/><TextBlock x:Name="UpscalerStatus" Text="Upscaler · Not identified" ToolTip="Cyberpunk can show its saved graphics choice. Other games may show a loaded AMD FSR or Intel XeSS library. Neither proves the final output when a mod or driver overrides it." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock x:Name="FrameTimeText" Grid.Row="2" Grid.ColumnSpan="7" Text="Waiting for game frames" Style="{StaticResource Muted}" Margin="0,8,0,0" VerticalAlignment="Bottom"/></Grid></Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FRAME TIME" Style="{StaticResource Muted}"/><local:FrameGraph x:Name="Chart" Height="110" Margin="0,10,20,0"/><TextBlock x:Name="ChartScale" Text="Actual frame times · 2 s playback delay for event delivery" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="PresentMode" Text="No active game"/><TextBlock Text="App FPS can include injected frames. Generated-frame coverage depends on the game and driver." Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Grid></Border>

     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU" Foreground="#FF8888" FontWeight="Bold"/><TextBlock x:Name="GpuName" Margin="0,8,0,16"/><TextBlock x:Name="GpuStats" LineHeight="24"/></StackPanel></Border>

      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU" Foreground="#FFBA77" FontWeight="Bold"/><TextBlock x:Name="CpuName" Margin="0,8,0,16"/><TextBlock x:Name="CpuStats" LineHeight="24"/><Expander Header="Usage by CPU thread" Foreground="#DDE4EF" Margin="0,10,0,0"><ItemsControl x:Name="CpuCoreList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander><TextBlock x:Name="SensorAvailability" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>

      <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="RAM" Foreground="#80BDFF" FontWeight="Bold"/><TextBlock Text="Physical memory used" Style="{StaticResource Muted}" Margin="0,22,0,8"/><TextBlock x:Name="MemoryStats" FontSize="42" FontWeight="SemiBold" Foreground="#80BDFF"/></StackPanel></Border>

     </Grid>

    </StackPanel></ScrollViewer>

   </TabItem>

   <TabItem Header="Overlay studio" AutomationProperties.AutomationId="StudioTab">

    <ScrollViewer x:Name="StudioWorkspaceScroll" VerticalScrollBarVisibility="Auto"><Grid Height="{Binding ViewportHeight, ElementName=StudioWorkspaceScroll}" MinHeight="680"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><WrapPanel><TextBlock Text="Your overlay. Your layout." FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="UnsavedLayoutNotice" Text="Unsaved edits" Visibility="Collapsed" Foreground="#FFBA77" VerticalAlignment="Center" Margin="14,0,0,0" AutomationProperties.AutomationId="UnsavedLayoutNotice"/></WrapPanel><TextBlock Text="Select items to move them together, or add individual metrics. Edit the selected item on the right." Foreground="#AEBED1" Margin="0,8,0,14"/>

      <WrapPanel Margin="0,0,0,10"><ComboBox Style="{StaticResource CaptureTargetStyle}" x:Name="DisplaySelector" Width="300" SelectionChanged="SelectDisplay" ToolTip="Choose the monitor represented by this canvas." AutomationProperties.AutomationId="DisplaySelector"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox x:Name="FollowDisplay" Content="Follow game display (canvas and overlay)" IsChecked="True" ToolTip="Move the canvas and overlay to the game's monitor automatically." Margin="12,6,0,0"/></WrapPanel>

      <WrapPanel Margin="0,0,0,8"><Button Content="Fit canvas" Click="FitStudio" ToolTip="Fit the full display on the canvas."/><Button x:Name="FitItemsButton" Content="Fit items" Click="FitItems" ToolTip="Zoom to the visible overlay items." Margin="8,0,0,0" AutomationProperties.AutomationId="FitItems"/><Button Content="100%" Click="ActualStudio" ToolTip="View the canvas at actual pixel size." Margin="8,0"/><TextBlock x:Name="ZoomLabel" VerticalAlignment="Center"/><Slider x:Name="ZoomSlider" Minimum="10" Maximum="400" Width="150" ValueChanged="ChangeZoom" PreviewMouseDoubleClick="ResetZoom" ToolTip="Canvas zoom: 10–400%. Default: fit canvas. Double-click to fit again." AutomationProperties.AutomationId="StudioZoom" Margin="8,0"/></WrapPanel>
      <WrapPanel Margin="0,0,0,8"><Button Content="Select all" Click="SelectAllOverlay" ToolTip="Select every visible item so you can move them together." AutomationProperties.AutomationId="SelectAllOverlay"/><Button x:Name="UndoStudioButton" Content="Undo" Click="UndoStudio" IsEnabled="False" ToolTip="Undo your last layout edit. Shortcut: Ctrl+Z." AutomationProperties.AutomationId="UndoStudio" Margin="8,0,0,0"/><CheckBox x:Name="EditorGrid" Content="Grid" IsChecked="True" Click="ChangeEditorGrid" ToolTip="Show alignment lines on the canvas." Margin="12,6"/><CheckBox x:Name="EditorSnap" Content="Snap" IsChecked="True" Click="ChangeEditorGrid" ToolTip="Align dragged items to the grid. Hold Ctrl to move freely." Margin="0,6"/><TextBlock Text="Drag empty space to select · Shift-click to add · Ctrl-drag moves freely · Right-click for tools · Right-drag to pan" Foreground="#AEBED1" VerticalAlignment="Center" Margin="12,0"/></WrapPanel>
     </StackPanel>
      <Border Grid.Row="1" BorderBrush="#405064" BorderThickness="1" CornerRadius="8" Padding="4" Background="#17202B"><ScrollViewer x:Name="PreviewViewport" MinHeight="80" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="StudioWheel" PreviewMouseDown="StartPan" PreviewMouseMove="PanStudio" PreviewMouseUp="EndPan" SizeChanged="ViewportResized" AutomationProperties.AutomationId="LayoutPreview"/></Border>

     <StackPanel Grid.Row="2">
      <TextBlock x:Name="CanvasDescription" Text="Detecting display…" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,16"/>

      <WrapPanel><Button x:Name="TestOverlayButton" Content="Test overlay" Click="ToggleOverlayTest" ToolTip="Show the live overlay without opening a game." AutomationProperties.AutomationId="TestOverlay" Margin="0,0,10,0"/><Button Content="Save &amp; apply" Click="SaveSettings" ToolTip="Save this layout and apply it to the overlay." AutomationProperties.AutomationId="SaveStudio" Background="{DynamicResource Accent}" Foreground="#10221C"/><TextBlock x:Name="StudioSaveState" Foreground="#83EFCD" VerticalAlignment="Center" Margin="10,0,0,0" AutomationProperties.AutomationId="StudioSaveState"/><Button Content="Export layout" Click="ExportLayout" ToolTip="Save a layout file to share or back up." Margin="10,0,0,0"/><Button Content="Import layout" Click="ImportLayout" ToolTip="Load a Frame Trace layout file." Margin="10,0,0,0"/></WrapPanel>

      <TextBlock x:Name="StudioStatus" Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,14,0,0"/>

     </StackPanel></Grid>

     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="SELECTED ITEM" Style="{StaticResource Muted}"/><ComboBox Style="{StaticResource CaptureTargetStyle}" x:Name="SectionSelector" ToolTip="Choose which overlay item to edit." SelectionChanged="SelectSection" AutomationProperties.AutomationId="SectionSelector" Margin="0,7,0,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding EditorLabel}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border>
      <TabControl x:Name="StudioInspectorTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="StudioInspectorTabs"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="#DDE4EF"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="InspectorTab" Background="#1B2732" BorderBrush="#354756" BorderThickness="1" CornerRadius="6" Padding="6,7" Margin="0,0,2,8"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="InspectorTab" Property="Background" Value="#285044"/><Setter TargetName="InspectorTab" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InspectorTab" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
       <TabItem Header="Item" AutomationProperties.AutomationId="StudioItemTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,9,8"><TextBlock Text="ITEM CONTENT" Style="{StaticResource Muted}" Margin="0,3,0,10"/><CheckBox x:Name="SectionVisible" Content="Show this item" ToolTip="Show or hide the selected overlay item." Click="EditSection" AutomationProperties.AutomationId="SectionVisible"/><CheckBox x:Name="ShowSectionName" Content="Show section title" ToolTip="Show the item title above its readings." Click="EditSection"/><TextBlock Text="Display name" Style="{StaticResource Muted}" Margin="0,14,0,5"/><TextBox x:Name="SectionName" MaxLength="80" TextChanged="EditSection" AutomationProperties.AutomationId="SectionName"/><TextBlock Text="Leave empty to use the detected hardware name." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/><CheckBox x:Name="HorizontalSection" Content="Put metrics on one line" ToolTip="Arrange readings across a single row." Click="EditSection"/><StackPanel x:Name="GraphOptions"><TextBlock Text="LIVE GRAPH" Style="{StaticResource Muted}" Margin="0,20,0,8"/><CheckBox x:Name="ShowGraph" Content="Show live graph" ToolTip="Plot recent frame time or hardware usage beside this item." Click="EditSection"/><CheckBox x:Name="GraphBelow" Content="Place graph below readings" ToolTip="Move the graph below this item’s readings." Click="EditSection"/><CheckBox x:Name="GraphTransparent" Content="Transparent · colored line only" ToolTip="Remove the graph background so only its line is visible." Click="EditSection" AutomationProperties.AutomationId="GraphTransparent"/><TextBlock Text="Graph width" Style="{StaticResource Muted}" Margin="0,10,0,5"/><Slider x:Name="GraphWidth" Minimum="120" Maximum="1200" Value="320" ToolTip="Width of this item’s live graph, in pixels." ValueChanged="EditSection"/><TextBlock Text="Graph height" Style="{StaticResource Muted}" Margin="0,10,0,5"/><Slider x:Name="GraphHeight" Minimum="40" Maximum="400" Value="90" ToolTip="Height of this item’s live graph, in pixels." ValueChanged="EditSection"/><TextBlock Text="FPS number size · 0 uses value size" Style="{StaticResource Muted}" Margin="0,10,0,5"/><Slider x:Name="HeroSize" Minimum="0" Maximum="96" ToolTip="Size of the large FPS number. Set to 0 to use the normal value size." ValueChanged="EditSection"/></StackPanel><Button x:Name="RemoveOverlayItemButton" Content="Remove selected item" ToolTip="Remove the selected item from this layout." Click="RemoveOverlayItem" Margin="0,20,0,0" AutomationProperties.AutomationId="RemoveOverlayItem"/></StackPanel></ScrollViewer></TabItem>
       <TabItem Header="Metrics" AutomationProperties.AutomationId="StudioMetricsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,9,8"><TextBlock Text="METRICS" Style="{StaticResource Muted}" Margin="0,3,0,6"/><TextBlock Text="Check readings to keep them in one item. Move out a reading below to give it its own item." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><ComboBox Style="{StaticResource CaptureTargetStyle}" x:Name="AddMetricSelector" ToolTip="Choose a reading to add as its own movable overlay item." AutomationProperties.AutomationId="AddMetricSelector"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="AddSeparateMetricButton" Content="Add separate metric" ToolTip="Add a new independent copy of this reading. Existing items stay as they are." Click="AddSeparateMetric" Margin="0,7,0,14" AutomationProperties.AutomationId="AddSeparateMetric"/><StackPanel x:Name="MetricOptions"/></StackPanel></ScrollViewer></TabItem>
       <TabItem x:Name="StudioArtworkTab" Header="Layers" Visibility="Collapsed" AutomationProperties.AutomationId="StudioArtworkTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ArtworkTools" Margin="0,4,9,8"/></ScrollViewer></TabItem>
       <TabItem Header="Visual" AutomationProperties.AutomationId="StudioVisualTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,9,8"><TextBlock Text="GRAPHICAL STYLE &amp; LIVE WIDGETS" Style="{StaticResource Muted}" Margin="0,3,0,8"/><StackPanel x:Name="WidgetOptions"/><Separator Margin="0,18,0,14"/><TextBlock Text="COLORS &amp; TEXT" Style="{StaticResource Muted}" Margin="0,0,0,9"/><WrapPanel><Button x:Name="NameColor" Content="Name color" ToolTip="Change the selected item’s title color." Click="PickNameColor" AutomationProperties.AutomationId="NameColor"/><Button x:Name="ValueColor" Content="Value color" ToolTip="Change the selected item’s reading color." Click="PickValueColor" AutomationProperties.AutomationId="ValueColor" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="Name size" Style="{StaticResource Muted}" Margin="0,16,0,6"/><Slider x:Name="NameSize" Minimum="10" Maximum="48" ToolTip="Size of the selected item’s title text." TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="EditSection" AutomationProperties.AutomationId="NameSize"/><CheckBox x:Name="IndependentLabelSize" Content="Independent label size" ToolTip="Set label text size separately from reading values." Click="EditSection"/><Slider x:Name="LabelSize" Minimum="8" Maximum="96" Value="16" ToolTip="Size of labels such as LOAD and TEMP when independent sizing is on." TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="EditSection" AutomationProperties.AutomationId="LabelSize"/><TextBlock Text="Value size" Style="{StaticResource Muted}" Margin="0,14,0,6"/><Slider x:Name="ValueSize" Minimum="10" Maximum="64" ToolTip="Size of the selected item’s numeric readings." TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="EditSection" AutomationProperties.AutomationId="ValueSize"/><TextBlock Text="Metric layout" Style="{StaticResource Muted}" Margin="0,14,0,5"/><ComboBox Style="{StaticResource CaptureTargetStyle}" x:Name="MetricLayoutSelector" ToolTip="Arrange readings in a row, aligned columns, or tiles." SelectedIndex="0" SelectionChanged="EditSection" AutomationProperties.AutomationId="MetricLayout"><ComboBoxItem Content="Flow · inline readings"/><ComboBoxItem Content="Table · aligned label/value columns"/><ComboBoxItem Content="Tiles · label above value"/></ComboBox><TextBlock Text="Section padding" Style="{StaticResource Muted}" Margin="0,12,0,5"/><Slider x:Name="SectionPadding" Minimum="0" Maximum="24" ToolTip="Space between this item’s content and its edge, in pixels." ValueChanged="EditSection"/><CheckBox x:Name="TextShadow" Content="Dark text shadow for readability" ToolTip="Add a subtle shadow behind text to keep it readable in games." Click="EditSection"/></StackPanel></ScrollViewer></TabItem>
       <TabItem Header="Canvas" AutomationProperties.AutomationId="StudioCanvasTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,9,8"><TextBlock Text="WHOLE OVERLAY" Style="{StaticResource Muted}" Margin="0,3,0,10"/><TextBlock Text="Font" Style="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox Style="{StaticResource CaptureTargetStyle}" x:Name="FontSelector" ToolTip="Choose the font used across the overlay." SelectedIndex="0" SelectionChanged="EditShared" AutomationProperties.AutomationId="FontSelector"><ComboBoxItem Content="Consolas"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Cascadia Mono"/></ComboBox><CheckBox x:Name="HideUnknownTechnology" Content="Hide unverified technology fields" IsChecked="True" Click="EditShared" ToolTip="Only show frame generation or upscaler information when it is verified."/><TextBlock Text="Overlay size · affects the in-game overlay" Style="{StaticResource Muted}" Margin="0,15,0,5"/><TextBlock x:Name="OverlaySizeLabel" Text="100%"/><Slider x:Name="OverlaySize" Minimum="50" Maximum="300" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ChangeOverlaySize" PreviewMouseDoubleClick="ResetOverlaySize" ToolTip="Scale the whole in-game overlay. Default: 100%. Double-click to reset." AutomationProperties.AutomationId="OverlaySize"/><TextBlock Text="Background opacity · 0% is transparent" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,15,0,7"/><Slider x:Name="PanelOpacity" Minimum="0" Maximum="1" Value="0.65" ValueChanged="EditShared" PreviewMouseDoubleClick="ResetPanelOpacity" ToolTip="Background opacity. Default: 65%. Double-click to reset." AutomationProperties.AutomationId="PanelOpacity"/><Button Content="Reset layout" ToolTip="Replace this layout with the default overlay arrangement." Click="ResetLayout" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
       <TabItem Header="Layouts" AutomationProperties.AutomationId="StudioLayoutsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,9,8"><TextBlock Text="BUILT-IN LAYOUTS" Style="{StaticResource Muted}" Margin="0,3,0,8"/><ComboBox Style="{StaticResource CaptureTargetStyle}" x:Name="PresetSelector" ToolTip="Choose a built-in starting layout." AutomationProperties.AutomationId="PresetSelector"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}"/><Border Margin="9,0,0,0" Padding="5,1" CornerRadius="3" Background="#285044"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="#83EFCD"/></Border></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="ApplyPresetButton" ToolTip="Load the selected built-in layout onto the canvas." AutomationProperties.AutomationId="ApplyPreset" Content="Use preset" Click="ApplyPreset" Margin="0,8,0,18"/><TextBlock Text="SAVED LAYOUTS" Style="{StaticResource Muted}" Margin="0,0,0,8"/><ComboBox Style="{StaticResource CaptureTargetStyle}" x:Name="CustomPresetSelector" ToolTip="Choose one of your saved layouts." MaxDropDownHeight="320" SelectionChanged="CustomPresetChanged" AutomationProperties.AutomationId="CustomPresetSelector"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><WrapPanel Margin="0,8,0,15"><Button x:Name="LoadCustomPresetButton" Content="Use saved" ToolTip="Load the selected saved layout." Click="LoadCustomPreset" IsEnabled="False" AutomationProperties.AutomationId="LoadCustomPreset"/><Button x:Name="DeleteCustomPresetButton" Content="Delete" ToolTip="Delete the selected saved layout." Click="DeleteCustomPreset" IsEnabled="False" Margin="7,0,0,0" AutomationProperties.AutomationId="DeleteCustomPreset"/></WrapPanel><TextBlock Text="Save current layout as" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="CustomPresetName" ToolTip="Name for your custom preset" MaxLength="60" AutomationProperties.AutomationId="CustomPresetName"/><Button Content="Save preset" ToolTip="Save the current canvas under the name above." Click="SaveCustomPreset" Margin="0,8,0,0" AutomationProperties.AutomationId="SaveCustomPreset"/></StackPanel></ScrollViewer></TabItem>
      </TabControl>
     </Grid>

    </Grid></ScrollViewer>

   </TabItem>

   <TabItem x:Name="SettingsPage" Header="Settings" AutomationProperties.AutomationId="SettingsTab">

     <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Startup &amp; shortcut" FontSize="22"/><TextBlock Text="Click the field, then press your shortcut. Ctrl + Shift + O works on compact keyboards." Foreground="#AEBED1" Margin="0,8,0,12"/><TextBox x:Name="HotkeyInput" IsReadOnly="True" PreviewKeyDown="RecordHotkey" AutomationProperties.AutomationId="HotkeyInput"/><CheckBox x:Name="OverlayStartup" Content="Enable the overlay when the app opens" IsChecked="True" Margin="0,16,0,0"/><CheckBox x:Name="StartMinimizedInput" Content="Open Frame Trace minimized to the taskbar" Margin="0,10,0,0"/><CheckBox x:Name="RunAtLoginInput" Content="Launch Frame Trace when I sign in to Windows" Margin="0,10,0,0"/></StackPanel></Border>

     <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Automatic game detection" FontSize="22"/><TextBlock Text="Capture runs continuously and follows the foreground rendering process. Common browsers, launchers, and desktop apps are ignored. Unknown games do not need a prebuilt game profile." Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock Text="Ignore these applications · one filename per line" Style="{StaticResource Muted}"/><TextBox x:Name="IgnoredApps" AcceptsReturn="True" Height="105" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="IgnoredApps" Margin="0,7,0,0"/><TextBlock Text="Dashboard Ignore/Allow updates this list and saves immediately. You can also edit filenames here, then choose Save settings." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>

      <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Sensors &amp; compatibility" FontSize="22"/><TextBlock Text="Hardware sensor update interval · CPU, GPU and RAM" Foreground="#AEBED1" Margin="0,12,0,4"/><DockPanel><TextBlock x:Name="SensorRefreshLabel" DockPanel.Dock="Right" Foreground="#83EFCD" VerticalAlignment="Center" Margin="12,0,0,0"/><Slider x:Name="SensorRefreshSlider" Minimum="250" Maximum="3000" Value="1000" TickFrequency="250" IsSnapToTickEnabled="True" ValueChanged="SensorRefreshChanged" PreviewMouseDoubleClick="ResetSensorRefresh" ToolTip="Hardware sensors only. Left is faster (250 ms); right is slower (3000 ms). Default: 1000 ms. Double-click to reset." AutomationProperties.AutomationId="SensorRefreshSlider"/></DockPanel><DockPanel LastChildFill="False" Margin="0,4,0,8"><TextBlock DockPanel.Dock="Left" Text="← Faster · 250 ms" Foreground="#83EFCD"/><TextBlock DockPanel.Dock="Right" Text="3000 ms · Slower →" Foreground="#AEBED1"/></DockPanel><TextBlock Text="Move left for faster hardware readings; move right for less sensor work. Save settings to apply. FPS and frame-time graphs do not use this slider. Windowed and borderless overlays use the Windows desktop compositor. True exclusive fullscreen is not supported by this desktop overlay. AFMF behavior can change when an overlay is visible; hide it to compare while capture continues." Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,8,0,12"/><CheckBox x:Name="InspectAmdUpscalerInput" Content="Experimental: identify upscaler evidence" ToolTip="For Cyberpunk, reads its saved graphics choice. For other games, checks loaded AMD FSR and Intel XeSS libraries. Neither proves the final output or detects driver and mod overrides. Leave module inspection off in anti-cheat games unless permitted by their rules." AutomationProperties.AutomationId="InspectAmdUpscaler" Margin="0,0,0,12"/><WrapPanel><Button Content="CPU sensor setup ↗" Click="OpenSensorDriver"/><Button x:Name="AdministratorButton" Content="Restart as administrator" Click="RestartElevated" Margin="10,0,0,0"/><Button Content="Export diagnostics" Click="ExportDiagnostics" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>

      <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Accessibility" FontSize="22"/><CheckBox x:Name="ReduceMotionInput" Content="Reduce motion" Margin="0,14,0,0"/><TextBlock Text="Pauses the app background and imported artwork animations. Sensor readings keep updating." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>

      <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Updates" FontSize="22"/><TextBlock Text="Check GitHub for a newer stable release. Choose Update now to download a verified installer and open it to finish updating. Not now dismisses the notice without downloading." Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,8,0,10"/><CheckBox x:Name="CheckUpdatesOnStartupInput" Content="Check for updates when Frame Trace opens"/><WrapPanel Margin="0,10,0,0"><Button x:Name="CheckForUpdatesButton" Content="Check now" Click="CheckForUpdates" AutomationProperties.AutomationId="CheckForUpdates"/><TextBlock x:Name="UpdateCheckStatus" Text="Not checked yet." Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/></WrapPanel></StackPanel></Border>

      <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Help improve Frame Trace" FontSize="22"/><TextBlock Text="Report a problem, share an idea, or request an app language. Spanish is the first planned translation." Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="ReportProblemButton" Content="Report a problem" Click="OpenBugReport" AutomationProperties.AutomationId="ReportProblem"/><Button x:Name="SendFeedbackButton" Content="Send feedback / Request a language" Click="OpenFeedback" AutomationProperties.AutomationId="SendFeedback" Margin="10,0,0,0"/></WrapPanel><TextBlock Text="Opens a public GitHub form. Review screenshots and diagnostics before sharing; nothing is uploaded automatically." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
      <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Save settings" Click="SaveSettings" AutomationProperties.AutomationId="SaveSettings" Background="{DynamicResource Accent}" Foreground="#10221C" HorizontalAlignment="Left"/><TextBlock x:Name="SettingsSaveState" Foreground="#83EFCD" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="600" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsSaveState"/></StackPanel>

    </Grid></ScrollViewer>

   </TabItem>

   <TabItem Header="About" AutomationProperties.AutomationId="AboutTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid AutomationProperties.AutomationId="AboutFrameTrace"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/FrameTrace.png" Width="64" Height="64" Margin="0,0,18,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="FRAME TRACE" FontFamily="Segoe UI Semibold" FontSize="29"/><TextBlock Text="{Binding Text, ElementName=AppVersion}" Foreground="#AEBED1"/></StackPanel></StackPanel><TextBlock Text="Game frame timing and hardware readings in an overlay you control." Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,16,0,0"/><Button Content="View project on GitHub ↗" Click="OpenProjectPage" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.AutomationId="OpenProjectPage"/></StackPanel></Border>
     <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Quick controls" FontSize="22"/><TextBlock Text="Ctrl + Shift + O   Toggle overlay" Margin="0,14,0,0"/><TextBlock Text="Ctrl + Z   Undo a Studio edit" Margin="0,8,0,0"/><TextBlock Text="Ctrl + wheel   Zoom the canvas" Margin="0,8,0,0"/><TextBlock Text="Right-drag   Pan the zoomed canvas" Margin="0,8,0,0"/><TextBlock Text="You can change the overlay shortcut in Settings." Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel></Border>
     <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Get started" FontSize="22"/><TextBlock Text="1   Open a game. Capture begins automatically." Margin="0,14,0,0"/><TextBlock Text="2   Check FPS and sensors on Dashboard." Margin="0,9,0,0"/><TextBlock Text="3   If capture misses your game, choose its running process from Capture target." TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock Text="Use Ignore or Allow there to control future automatic capture." Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>
     <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Shape your overlay" FontSize="22"/><TextBlock Text="Move items in Overlay Studio, edit their labels and colors, and choose which readings to show." TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="Test overlay shows live changes before you save. When it looks right, select Save &amp; apply." TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Artwork and sharing" FontSize="22"/><TextBlock Text="In Layers, open an RTSS .ovl beside its companion PNG. Add an image or animation, resize it, and choose its playback." TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="Save your layout in Layouts, or export it as a file to share with someone else." TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Help and current limits" FontSize="22"/><TextBlock Text="Some RTSS sources still need manual work. True exclusive fullscreen and game-specific upscaler detection are not available yet." Foreground="#AEBED1" TextWrapping="Wrap" Margin="0,14,0,14"/><WrapPanel><Button Content="Report a problem ↗" Click="OpenBugReport"/><Button Content="Share an idea ↗" Click="OpenFeedback" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
    </Grid></ScrollViewer>
   </TabItem>

  </TabControl>

   <TextBlock x:Name="Status" Grid.Row="3" Text="Starting automatic capture…" Foreground="#AEBED1" Margin="0,18,0,0" TextWrapping="Wrap"/>

 </Grid>
 </Grid>

</Window>
